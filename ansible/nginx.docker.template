server {
    listen 5102 ssl;

    ssl_certificate /etc/nginx/ssl/{{ data.node.host }}.crt;
    ssl_certificate_key /etc/nginx/ssl/{{ data.node.host }}.key;

    client_max_body_size 0;

    server_name {{ data.node.host }};
    location / {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_pass http://unix:/var/run/docker.sock;

        auth_basic           "Administrator’s Area";
        auth_basic_user_file /etc/nginx/conf.d/docker.htpasswd;
    }
}