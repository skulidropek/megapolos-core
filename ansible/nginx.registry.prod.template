server {
    listen 80;
    server_name {{ data.registry_domain }};

    listen 443 ssl; # managed by Certbot

    ssl_certificate /etc/letsencrypt/live/{{ data.registry_domain }}/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/{{ data.registry_domain }}/privkey.pem; # managed by Certbot

    client_max_body_size 0;

    location / {
        proxy_pass http://{{ data.node.host }}:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 900;

    }
}
