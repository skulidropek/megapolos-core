server {
    listen 5104 ssl; # managed by Certbot

    # RSA certificate
    ssl_certificate /etc/letsencrypt/live/{{ data.node.host }}/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/{{ data.node.host }}/privkey.pem; # managed by Certbot

    client_max_body_size 0;

    server_name {{ data.node.host }};
    location / {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_pass http://{{ data.node.host }}:5100;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}